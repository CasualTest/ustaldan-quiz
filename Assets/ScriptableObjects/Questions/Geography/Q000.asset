  category: {fileID: 11400000, guid: ede89710f77f6df4f807db79dba16c5c, type: 2}
  questionText: "\u041A\u0430\u043A\u0430\u044F \u0447\u0430\u0441\u0442\u044C \u0420\u0435\u0441\u043F\u0443\u0431\u043B\u0438\u043A\u0438
    \u0421\u0430\u0445\u0430 (\u042F\u043A\u0443\u0442\u0438\u044F) \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
    \u0423\u0441\u0442\u044C-\u0410\u043B\u0434\u0430\u043D\u0441\u043A\u0438\u0439
    \u0440\u0430\u0439\u043E\u043D?"
  questionTextSah: "\u0421\u0430\u0445\u0430 \u04E8\u0440\u04E9\u0441\u043F\u04AF\u04AF\u0431\u04AF\u043B\u04AF\u043A\u044D\u0442\u0438\u043D
    \u0445\u0430\u043D\u043D\u044B\u043A \u04E9\u0442\u0442\u04AF\u0433\u044D\u0440
    \u0423\u0443\u0441-\u0410\u043B\u0434\u0430\u043D \u043E\u0440\u043E\u0439\u0443\u043E\u043D\u0430
    \u0441\u044B\u0442\u0430\u0440\u044B\u0439?"
  questionImage: {fileID: 0}
  answers:
  - "\u0421\u0435\u0432\u0435\u0440\u043E-\u0432\u043E\u0441\u0442\u043E\u0447\u043D\u0430\u044F"
  - "\u0421\u0435\u0432\u0435\u0440\u043E-\u0437\u0430\u043F\u0430\u0434\u043D\u0430\u044F"
  - "\u0426\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u0430\u044F"
  - "\u042E\u0436\u043D\u0430\u044F"
  difficulty: 1
  factAfterRu: "\u0423\u0441\u0442\u044C-\u0410\u043B\u0434\u0430\u043D\u0441\u043A\u0438\u0439
    \u0440\u0430\u0439\u043E\u043D \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D
    \u0432 \u0441\u0435\u0432\u0435\u0440\u043E-\u0432\u043E\u0441\u0442\u043E\u0447\u043D\u043E\u0439
    \u0447\u0430\u0441\u0442\u0438 \u0420\u0435\u0441\u043F\u0443\u0431\u043B\u0438\u043A\u0438
    \u0421\u0430\u0445\u0430 (\u042F\u043A\u0443\u0442\u0438\u044F)."
  factAfterSah: "\u0423\u0441\u0442\u044D-\u0410\u043B\u0434\u0430\u043D \u0430\u0439\u043C\u0430\u0493\u044B
    \u0421\u0430\u0445\u0430 \u0421\u0438\u0440\u044D\u043B\u044D (\u042F\u043A\u0443\u0442\u0438\u044F)
    \u0442\u04AF\u043C\u04AF\u0433\u044D-\u0438\u0434\u044D \u043A\u04AD\u04E9\u0440\u04E9\u043B\u044D\u044D\u043D."
