  m_Script: {fileID: 11500000, guid: 6fc2304c59180a740bc3ec9d2eb9dda7, type: 3}
  m_Name: Q000
  m_EditorClassIdentifier: 
  category: {fileID: 11400000, guid: 6cb06c8a26a77c44384176150f88cef8, type: 2}
  questionText: "\u041A\u0430\u043A\u0438\u0435 \u043F\u0430\u043C\u044F\u0442\u043D\u0438\u043A\u0438
    \u043A\u0443\u043B\u044C\u0442\u0443\u0440\u044B \u0438 \u0438\u0441\u0442\u043E\u0440\u0438\u0438
    \u043E\u0445\u0440\u0430\u043D\u044F\u044E\u0442\u0441\u044F \u0432 \u0440\u0430\u0439\u043E\u043D\u0435?"
  questionTextSah: "\u041E\u0440\u043E\u0439\u0443\u043E\u04A5\u04A5\u0430 \u041A\u0443\u043B\u0442\u0443\u0443\u0440\u0430
    \u0443\u043E\u043D\u043D\u0430 \u0443\u0441\u0442\u0443\u043E\u0440\u0443\u0439\u0430
    \u0445\u0430\u043D\u043D\u044B\u043A \u043F\u0430\u0430\u043C\u044B\u0442\u043D\u044C\u044B\u043A\u0442\u0430\u0440\u0430
    \u0441\u0443\u0434\u0430\u0430\u0440\u044B\u0441\u0442\u044B\u0431\u0430 \u0445\u0430\u0440\u044B\u0441\u0442\u0430\u0431\u044B\u043B\u044B\u0433\u0430\u0440
    \u0442\u0443\u0440\u0430\u0440 \u0431\u0443\u043E\u043B\u0443\u043E\u0445\u0442\u0430\u0440\u044B\u043D
    \u0441\u04E9\u0431\u04AF\u0439?"
  questionImage: {fileID: 0}
  answers:
  - "\u0412\u0441\u0435 \u043F\u0435\u0440\u0435\u0447\u0438\u0441\u043B\u0435\u043D\u043D\u043E\u0435
    \u0432\u044B\u0448\u0435"
  - "\u0421\u0432\u044F\u0449\u0435\u043D\u043D\u044B\u0435 \u043C\u0435\u0441\u0442\u0430
    \u0438 \u0441\u0432\u044F\u0442\u0438\u043B\u0438\u0449\u0430"
  - "\u041F\u0430\u043C\u044F\u0442\u043D\u0438\u043A\u0438 \u043F\u0440\u0438\u0440\u043E\u0434\u044B"
  - "\u0418\u0441\u0442\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u043F\u043E\u0441\u0442\u0440\u043E\u0439\u043A\u0438"
  difficulty: 1
  factAfterRu: "\u0412 \u0440\u0430\u0439\u043E\u043D\u0435 \u043E\u0445\u0440\u0430\u043D\u044F\u044E\u0442\u0441\u044F
    \u0438\u0441\u0442\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u043F\u043E\u0441\u0442\u0440\u043E\u0439\u043A\u0438,
    \u0441\u0432\u044F\u0449\u0435\u043D\u043D\u044B\u0435 \u043C\u0435\u0441\u0442\u0430,
    \u0441\u0432\u044F\u0442\u0438\u043B\u0438\u0449\u0430 \u0438 \u043F\u0430\u043C\u044F\u0442\u043D\u0438\u043A\u0438
    \u043F\u0440\u0438\u0440\u043E\u0434\u044B, \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0449\u0438\u0435
    \u043A\u0443\u043B\u044C\u0442\u0443\u0440\u043D\u043E\u0435 \u043D\u0430\u0441\u043B\u0435\u0434\u0438\u0435
    \u0440\u0430\u0439\u043E\u043D\u0430."
  factAfterSah: "\u0410\u0439\u043C\u0430\u0493\u044B\u043D \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0432\u0430\u043B\u043B\u044B\u0431\u044B\u0442
    \u0438\u0441\u0442\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u0435\u0439 \u043F\u043E\u0441\u0442\u0440\u043E\u0439\u044C\u0442\u0430\u0440,
    \u0441\u0430\u043D\u0430 \u044D\u04BB\u044D \u0443\u043E\u043D\u043D\u0430 \u04BB\u0430\u043D\u0438\u0442\u0430\u0440\u0438\u043B\u044C\u0430\u0440,
    \u0442\u0430\u0431\u044B\u0433\u0430 \u043F\u0430\u043C\u044F\u0442\u043D\u0438\u043A\u0442\u0430\u0440,
    \u0431\u0443\u043A\u0430 \u043A\u0443\u043B\u044C\u0442\u0443\u0440\u0430\u043B\u044B\u044B
    \u043D\u0430\u0441\u043B\u0435\u0434\u043E\u043A\u043A\u043E\u0445\u043E \u044D\u043C\u0438\u0438\u043B\u0438\u0431\u0438\u0442\u044D."
