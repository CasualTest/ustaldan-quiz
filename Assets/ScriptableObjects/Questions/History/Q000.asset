  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6fc2304c59180a740bc3ec9d2eb9dda7, type: 3}
  m_Name: Q000
  m_EditorClassIdentifier: 
  category: {fileID: 11400000, guid: 3391d653de9479543b2fde820277d97f, type: 2}
  questionText: "\u041A\u0430\u043A\u0438\u0435 \u0438\u043D\u0444\u0440\u0430\u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u043D\u044B\u0435
    \u043F\u0440\u043E\u0435\u043A\u0442\u044B \u0431\u044B\u043B\u0438 \u0440\u0435\u0430\u043B\u0438\u0437\u043E\u0432\u0430\u043D\u044B
    \u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 20-30 \u043B\u0435\u0442
    \u0432 \u0440\u0430\u0439\u043E\u043D\u0435?"
  questionTextSah: "\u041A\u043E\u0440\u0443\u043E\u043D \u0442\u0438\u04BB\u044D\u0445
    20-30 \u0441\u044B\u043B\u043B\u0430\u0440\u044B\u0433\u0430\u0440 \u043E\u0440\u043E\u0439\u0443\u043E\u04A5\u04A5\u0430
    \u0445\u0430\u043D\u043D\u044B\u043A \u0438\u043D\u0444\u0440\u0430\u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u043D\u0430\u0439
    \u0431\u044B\u0440\u0430\u0439\u044B\u0430\u043A\u0442\u0430\u0440 \u043E\u043B\u043E\u0445\u0445\u043E
    \u043A\u0438\u0438\u0440\u0434\u0438\u043B\u044D\u0440?"
  questionImage: {fileID: 0}
  answers:
  - "\u0412\u0441\u0435 \u043F\u0435\u0440\u0435\u0447\u0438\u0441\u043B\u0435\u043D\u043D\u043E\u0435
    \u0432\u044B\u0448\u0435"
  - "\u0420\u0430\u0441\u0448\u0438\u0440\u0435\u043D\u0438\u0435 \u0430\u044D\u0440\u043E\u043F\u043E\u0440\u0442\u0430"
  - "\u0421\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
    \u043D\u043E\u0432\u044B\u0445 \u0448\u043A\u043E\u043B \u0438 \u0431\u043E\u043B\u044C\u043D\u0438\u0446"
  - "\u041C\u043E\u0434\u0435\u0440\u043D\u0438\u0437\u0430\u0446\u0438\u044F \u042F\u0410\u0414"
  difficulty: 1
  factAfterRu: "\u0412 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u0434\u0435\u0441\u044F\u0442\u0438\u043B\u0435\u0442\u0438\u044F
    \u0440\u0435\u0430\u043B\u0438\u0437\u043E\u0432\u0430\u043D\u044B \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441\u043D\u044B\u0435
    \u043F\u0440\u043E\u0435\u043A\u0442\u044B \u043F\u043E \u043C\u043E\u0434\u0435\u0440\u043D\u0438\u0437\u0430\u0446\u0438\u0438
    \u0434\u043E\u0440\u043E\u0433, \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043D\u0438\u044E
    \u0430\u044D\u0440\u043E\u043F\u043E\u0440\u0442\u0430 \u0438 \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0443
    \u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0445 \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u0432."
  factAfterSah: "\u041E\u04A5 \u0441\u044B\u043B\u0442\u0430\u0430\u0445\u0445\u0430
    \u0442\u04E9\u04A5\u04AF\u043D\u04AF\u043B\u043B\u044D\u044D\u0445 \u043F\u0440\u043E\u0435\u043A\u0442\u044B\u043B\u043B\u0430\u0440
    \u044D\u043C\u0438\u0438\u043B\u0438\u04A5\u0438 \u042F\u0410\u0414 \u043C\u043E\u0434\u0435\u0440\u043D\u0438\u0437\u0430\u0446\u0438\u044F\u043B\u044B\u044B,
    \u0430\u044D\u0440\u043E\u043F\u043E\u0440\u0442\u043A\u0430 \u04E9\u0441\u04AF\u043C\u0442\u04AF\u04AF\u043B\u044D,
    \u0448\u043A\u043E\u043B\u0430 \u0443\u043E\u043D\u043D\u0430 \u0431\u043E\u043B\u044C\u043D\u0438\u0446\u0430\u0442\u0430\u0440
    \u0430\u0431\u0430\u043B\u0430\u0441\u0442\u044B\u044B."
