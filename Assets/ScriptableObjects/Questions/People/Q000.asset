  m_Script: {fileID: 11500000, guid: 6fc2304c59180a740bc3ec9d2eb9dda7, type: 3}
  m_Name: Q000
  m_EditorClassIdentifier: 
  category: {fileID: 11400000, guid: ea9fd6109725dce4387c1e07a032516f, type: 2}
  questionText: "\u041A\u0430\u043A\u0438\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0435
    \u0434\u0435\u044F\u0442\u0435\u043B\u0438 \u043D\u0430\u0443\u043A\u0438, \u043A\u0443\u043B\u044C\u0442\u0443\u0440\u044B
    \u0438\u043B\u0438 \u0441\u043F\u043E\u0440\u0442\u0430 \u0441\u0432\u044F\u0437\u0430\u043D\u044B
    \u0441 \u0438\u0441\u0442\u043E\u0440\u0438\u0435\u0439 \u0440\u0430\u0439\u043E\u043D\u0430?"
  questionTextSah: "\u041D\u0430\u0443\u043A\u0430, \u043A\u0443\u043B\u0442\u0443\u0443\u0440\u0430
    \u044D\u0431\u044D\u0442\u044D\u0440 \u0441\u043F\u043E\u0440\u0442 \u0445\u0430\u043D\u043D\u044B\u043A
    \u0431\u0438\u043B\u043B\u044D\u0440 \u0434\u0438\u044D\u0439\u044D\u0442\u044D\u043B\u043B\u044D\u0440\u044D
    \u043E\u0440\u043E\u0439\u0443\u043E\u043D \u0443\u0441\u0442\u0443\u043E\u0440\u0443\u0439\u0430\u0442\u044B\u043D
    \u043A\u044B\u0442\u0442\u0430 \u0441\u0438\u0431\u044D\u044D\u0441\u0442\u044D\u044D\u0445\u0442\u044D\u0440\u0438\u0439?"
  questionImage: {fileID: 0}
  answers:
  - "\u0425\u0443\u0434\u043E\u0436\u043D\u0438\u043A\u0438"
  - "\u0423\u0447\u0451\u043D\u044B\u0435"
  - "\u0421\u043F\u043E\u0440\u0442\u0441\u043C\u0435\u043D\u044B"
  - "\u041F\u0438\u0441\u0430\u0442\u0435\u043B\u0438"
  difficulty: 1
  factAfterRu: "\u0418\u0441\u0442\u043E\u0440\u0438\u044F \u0440\u0430\u0439\u043E\u043D\u0430
    \u0441\u0432\u044F\u0437\u0430\u043D\u0430 \u0441 \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E
    \u043F\u0438\u0441\u0430\u0442\u0435\u043B\u0435\u0439, \u0443\u0447\u0451\u043D\u044B\u0445,
    \u0441\u043F\u043E\u0440\u0442\u0441\u043C\u0435\u043D\u043E\u0432 \u0438 \u0445\u0443\u0434\u043E\u0436\u043D\u0438\u043A\u043E\u0432,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043B\u0438\u0431\u043E \u0440\u043E\u0434\u0438\u043B\u0438\u0441\u044C
    \u0432 \u0440\u0430\u0439\u043E\u043D\u0435, \u043B\u0438\u0431\u043E \u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0438
    \u0435\u0433\u043E \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044E."
  factAfterSah: "\u0410\u0439\u043C\u0430\u0493\u044B\u043D \u0438\u0441\u0442\u043E\u0440\u0438\u044F
    \u0442\u0443\u04BB\u0443\u043B\u0430\u0430\u0445 \u043F\u0438\u0441\u0430\u0442\u0435\u043B\u044B\u043A\u0442\u0430\u0440,
    \u0443\u0447\u0451\u043D\u043E\u0439\u0435, \u0441\u043F\u043E\u0440\u0442\u0441\u043C\u0435\u043D\u044B
    \u0443\u043E\u043D\u043D\u0430 \u0445\u0443\u0434\u043E\u0436\u043D\u0438\u043A\u044B\u0442\u0430\u0440,
    \u043E\u043D\u0442\u043E\u04B3\u043E \u0443\u0443\u0441 \u044D\u0439\u0438\u0433\u044D\u0442\u044D
    \u043A\u044D\u043B\u044D \u043A\u044D\u0440\u044D\u04B3\u0435 \u0438\u04BB\u044D
    \u043A\u044D\u043B\u0431\u0438\u043A\u043A\u044D \u0430\u0439\u043C\u0430\u0493\u044B\u043D
    \u04E9\u0441\u04AF\u043C\u0442\u04AF\u04AF\u043B\u044D\u0440\u0433\u044D."
